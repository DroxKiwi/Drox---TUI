# Fichier `.env` de Drox — copie en `.drox/env` (à la racine du repo ou en
# `~/.drox/env`) pour activation automatique au démarrage de `drox` /
# `drox --serve`.
#
# Format : KEY=VALUE par ligne. Commentaires en `#`. Pas d'expansion `$VAR`.
# Valeurs entre guillemets simples ou doubles tolérées. Une variable déjà
# définie dans l'environnement shell prime (le `.env` n'écrase JAMAIS).
#
# Priorité : flags CLI > env shell > `<workspace>/.drox/env` > `~/.drox/env`.

# --- Serveur LLM ---
# URL d'Ollama (ou tout serveur compatible /api/chat). Peut pointer vers un
# reverse-proxy / API gateway distant.
DROX_SERVER=http://localhost:11434

# Modèle à charger côté serveur.
DROX_MODEL=llama3.2

# --- Authentification (optionnel) ---
# API key envoyée comme header `x-api-key: <valeur>` sur chaque requête.
# Utile derrière un reverse-proxy / Cloudflare Access / Bearer-relay.
# DROX_API_KEY=sk-xxx

# Pour d'autres headers (Authorization, etc.), utiliser le flag CLI :
#   drox --header "Authorization: Bearer xxx" --prompt "..."
# (ou côté JSON-RPC : champs `apiKey` / `headers` de `agent.run`)

# --- Langue principale (optionnel) ---
# Force la langue de réponse de l'assistant. Accepte des codes ISO courts
# (`fr`, `en`, `es`, `de`, `it`, `pt`, `nl`, `ja`, `zh`, `ko`, `ru`, `ar`,
# `pl`, `tr`), des variantes régionales (`fr-CA`, `pt-BR`) ou un nom libre
# (`Français`, `English`, `Esperanto`, ...). L'instruction est injectée en
# tête du prompt système, juste avant le contenu du memdir (`MEMORY.md`,
# `DROX.md`).
# DROX_PRIMARY_LANGUAGE=fr

# --- Sampling Ollama (optionnel) ---
# Les valeurs ci-dessous correspondent 1:1 aux options Ollama. Drox les
# pousse à chaque requête `/api/chat`. Surchargeables aussi via les
# settings VS Code (`drox.numPredict`, `drox.numCtx`, ...).
#
# Tokens générés max par tour. Défaut Ollama : 128 (trop bas → coupe les
# tool_calls). Drox force 4096.
# DROX_NUM_PREDICT=4096
#
# Taille de la fenêtre de contexte. Défaut Ollama : 2048 (trop bas pour
# Drox). Drox force 32768.
# DROX_NUM_CTX=32768
#
# Sampling nucleus (0.5–0.95). Défaut Ollama : 0.9. Plus bas = plus
# conservateur.
# DROX_TOP_P=0.9
#
# Top-K (10–100). Défaut Ollama : 40.
# DROX_TOP_K=40
#
# Pénalité de répétition (1.0–1.5). Défaut Ollama : 1.1. Augmenter si le
# modèle boucle.
# DROX_REPEAT_PENALTY=1.1
#
# Seed déterministe (utile pour debug / reproductibilité). Vide ou -1 =
# aléatoire.
# DROX_SEED=42
